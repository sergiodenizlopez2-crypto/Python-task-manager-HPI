def complete_task(tasks):
    if len(tasks) == 0:
        print("There are no tasks to complete.")
        return

    print("Tasks:")
    for i in range(len(tasks)):
        task = tasks[i]
        if task["completed"]:
            status = "Completed"
        else:
            status = "Pending"
        print(i + 1, ".", task["name"], "| Deadline:", task["deadline"], "|", status)

    choice = input("Enter the number of the task to complete: ")
    if not choice.isdigit() or int(choice) < 1 or int(choice) > len(tasks):
        print("Invalid task number.")
        return

    task = tasks[int(choice) - 1]
    if task["completed"]:
        print("This task was already completed.")
    else:
        task["completed"] = True
        print("Task", task["name"], "marked as completed!")
